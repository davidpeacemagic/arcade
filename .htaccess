# Beat The Arcade — Apache configuration
#
# Serves the flat .html files from extensionless URLs: /tictactoe works, and
# /tictactoe.html 301s to it, so every page has exactly one address.
#
# Apache only — GitHub Pages, Netlify, Cloudflare Pages and `python3 -m
# http.server` all ignore this file.
#
# The host must permit .htaccess overrides for this directory (`AllowOverride
# FileInfo`, or All). If the server answers 500, that is the usual cause.

# mod_negotiation would resolve /tictactoe to tictactoe.html on its own, which
# answers with a redirect that fights the canonical rules below. This file does
# the job explicitly, so negotiation is switched off.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- canonical redirects: one URL per page ------------------------------

  # /index.html -> /      (and /some/dir/index.html -> /some/dir/)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  # ...but only if that index.html is really there, so a request for a missing
  # page 404s instead of 301-ing into a dead end (a redirect browsers cache).
  RewriteCond %{DOCUMENT_ROOT}/%1index.html -f
  RewriteRule ^ /%1 [R=301,L,NE]

  # /tictactoe.html -> /tictactoe
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1 [R=301,L,NE]

  # /tictactoe/ -> /tictactoe      (no trailing-slash duplicate of the same page)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/$ /$1 [R=301,L,NE]

  # --- internal rewrite: /tictactoe -> tictactoe.html ---------------------
  # The URL bar keeps the clean form; only the file served changes, which is
  # why the flat layout stays put and every relative asset path (css/…, js/…)
  # keeps working untouched.

  # Skip anything that is a real file or directory (stylesheets, scripts, and
  # the document root itself, where DirectoryIndex handles the homepage).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Only rewrite when the .html file actually exists, so unknown paths still
  # 404 properly instead of being swallowed by a catch-all.
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

DirectoryIndex index.html

# --- caching ---------------------------------------------------------------
# The CDN in front (`hcdn`) serves the HTML pages dynamically — every page
# request reaches this server, so a page edit is live the moment it is uploaded
# — and caches CSS and JS at its edge. How long it keeps them comes from these
# headers: the CDN honours `s-maxage`, browsers honour `max-age`.
#
# The host's own default is seven days (`public, max-age=604800` plus an
# `Expires` a week out), which is what makes a stylesheet edit invisible for a
# week unless the URL changes. Five minutes overrules it: short enough that an
# edit appears on its own, with no version tag in the URLs and no manual cache
# flush; long enough that clicking through the games does not refetch the same
# twelve files on every page. Revalidating after that is cheap — this server
# already sends an ETag, so it answers 304.
#
# If a change ever stops appearing, check that this whole file is really on the
# server, then press `Flush cache` in the CDN panel. An older copy of this file
# has been deployed before, and the CDN holds its own copies independently.
#
# The `IfModule` guard hides a silent failure: without mod_headers none of this
# applies and the host's seven-day default stands, with no error to show for it.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "public, max-age=300, s-maxage=300, must-revalidate"
  </FilesMatch>
</IfModule>

# --- keep the repo's own files off the web ---------------------------------
# README.md documents how the games work, including the Rock Paper Scissors
# reset script, so it is not something to serve — neither are editor and OS
# leftovers. Anything with a leading dot is covered too (.htaccess itself is
# already hidden by Apache's default config; this is belt and braces).
# Guarded on mod_authz_core so an Apache 2.2 host cannot 500 on `Require`;
# on such a host this block is simply skipped.
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(md|markdown|txt|json|ya?ml|lock|swp|orig|bak)$)">
    Require all denied
  </FilesMatch>
</IfModule>
